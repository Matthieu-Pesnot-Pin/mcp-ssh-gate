{
  "name": "@imenam/mcp-ssh-gate",
  "version": "1.0.7",
  "description": "MCP server that lets an agent run commands on production servers over SSH only after a human approves them in a web GUI. The SSH keys are generated by the server and stored encrypted.",
  "main": "dist/src/index.js",
  "scripts": {
    "test": "node --test \"dist/test/*.test.js\"",
    "build:backend": "tsc",
    "build:gui": "cd gui && npm install && npm run build",
    "build": "npm run build:backend && npm run build:gui",
    "start": "node dist/src/index.js",
    "prepublishOnly": "npm run build",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "human-in-the-loop",
    "devops",
    "agent"
  ],
  "type": "module",
  "author": "Imena",
  "license": "ISC",
  "bin": {
    "mcp-ssh-gate": "dist/src/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src",
    "dist/shared",
    "gui/dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Matthieu-Pesnot-Pin/mcp-ssh-gate.git"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@imenam/mcp-gui-interface": "^1.0.15",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "hono": "^4.13.17",
    "ssh2": "^1.17.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/Matthieu-Pesnot-Pin/mcp-ssh-gate#readme",
  "bugs": {
    "url": "https://github.com/Matthieu-Pesnot-Pin/mcp-ssh-gate/issues"
  }
}
